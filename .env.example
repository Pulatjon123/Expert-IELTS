# ── Database (PostgreSQL / Supabase) ──
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/expert_ielts"

# ── Owner admin account (created/updated by `npm run db:seed`). Stored hashed; never shipped to the browser. ──
ADMIN_EMAIL="owner@example.com"
ADMIN_PASSWORD="change-me-to-a-long-random-password"
ADMIN_NAME="Site Owner"

# ── Claude AI (question analysis, model essays, assessment, examiner, reports) ──
# Get a key at https://console.anthropic.com — usage is billed to the owner, never to students.
ANTHROPIC_API_KEY=""

# ── Speech-to-text (any OpenAI-compatible Whisper endpoint) ──
# Groq (cheap/fast):   STT_API_URL="https://api.groq.com/openai/v1"  STT_MODEL="whisper-large-v3"
# OpenAI:              STT_API_URL="https://api.openai.com/v1"      STT_MODEL="whisper-1"
# Self-hosted (free):  any faster-whisper server exposing /audio/transcriptions
STT_API_URL=""
STT_API_KEY=""
STT_MODEL="whisper-large-v3"

# ── Pronunciation assessment from audio (optional, Azure Speech) ──
# Without it, Pronunciation is shown as "not assessed" instead of being guessed from text.
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION=""

# ── Where recorded audio is stored (local disk path). ──
UPLOAD_DIR="./storage"

# ── Scheduled weekly reports (optional). Vercel Cron sends this automatically as a Bearer token. ──
CRON_SECRET=""

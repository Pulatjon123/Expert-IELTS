// EXPERT IELTS — database schema
// All educational features are free: there are no plans, tiers, credits or payments in this schema.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum WritingTask {
  TASK1
  TASK2
}

/// Where a question came from. Never label something VERIFIED_REPORT without a source note.
enum QuestionSource {
  VERIFIED_REPORT // reported by real candidates, verified by the admin (sourceNote required)
  AI_GENERATED // generated by the AI — never presented as a real exam question
  PRACTICE // written by the platform team in IELTS style
}

enum Skill {
  WRITING
  SPEAKING
}

enum AttemptStatus {
  DRAFT
  SUBMITTED
  EVALUATED
  FAILED
}

enum SpeakingMode {
  PRACTICE // first attempt -> preparation -> second attempt
  INTERVIEW // AI examiner with follow-up questions
}

enum WeaknessStatus {
  ACTIVE
  IMPROVING
  RESOLVED
}

enum VocabKind {
  WORD
  COLLOCATION
  PHRASE
}

enum UsageVerdict {
  CORRECT
  INCORRECT
  UNNATURAL
}

model User {
  id              String        @id @default(cuid())
  email           String        @unique
  name            String
  passwordHash    String
  role            Role          @default(STUDENT)
  status          AccountStatus @default(ACTIVE)
  locale          String        @default("en")
  targetBand      Float?
  examDate        DateTime?
  reminderEnabled Boolean       @default(false)
  reminderDays    Int[]         @default([])
  createdAt       DateTime      @default(now())
  lastActiveAt    DateTime      @default(now())

  sessions          Session[]
  writingAttempts   WritingAttempt[]
  speakingSessions  SpeakingSession[]
  weaknesses        Weakness[]
  vocabItems        VocabItem[]
  weeklyReports     WeeklyReport[]
  bookmarks         Bookmark[]
  questionHistory   QuestionHistory[]
  goals             LearningGoal[]
  aiUsage           AiUsageLog[]
}

model Session {
  id        String   @id // SHA-256 hash of the cookie token; the raw token is never stored
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?

  @@index([userId])
}

// ───────────────────────────── Questions ─────────────────────────────

model WritingQuestion {
  id         String         @id @default(cuid())
  task       WritingTask
  category   String // e.g. LINE_GRAPH, OPINION
  topic      String
  prompt     String
  /// Structured data for Task 1 visuals (chart/table/map/process) rendered by the frontend.
  visual     Json?
  imageUrl   String?
  source     QuestionSource @default(PRACTICE)
  sourceNote String?
  reportedAt DateTime?
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  attempts    WritingAttempt[]
  prep        WritingPrep?

  @@index([task, isActive])
}

/// One Speaking question set. Part 1 & 3: a list of questions. Part 2: a cue card with bullet points.
model SpeakingTopic {
  id           String         @id @default(cuid())
  part         Int // 1, 2, 3
  topic        String
  title        String
  questions    String[] // Part 1 / Part 3 questions in natural order
  cueCard      String? // Part 2 main prompt ("Describe a ...")
  bulletPoints String[] // Part 2 "You should say:" points
  linkedTopicId String? // Part 3 set linked to a Part 2 cue card
  source       QuestionSource @default(PRACTICE)
  sourceNote   String?
  reportedAt   DateTime?
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  sessions SpeakingSession[]
  prep     SpeakingPrep?

  @@index([part, isActive])
}

model QuestionHistory {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill      Skill
  questionId String
  servedAt   DateTime @default(now())

  @@index([userId, skill, servedAt])
}

model Bookmark {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill      Skill
  questionId String
  createdAt  DateTime @default(now())

  @@unique([userId, skill, questionId])
}

// ───────────────────────────── Writing ─────────────────────────────

/// AI preparation material, cached per question (shared by all students to keep AI costs low).
model WritingPrep {
  id         String          @id @default(cuid())
  questionId String          @unique
  question   WritingQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  content    Json
  model      String
  createdAt  DateTime        @default(now())
}

model WritingAttempt {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId   String
  question     WritingQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  content      String          @default("")
  wordCount    Int             @default(0)
  timeSpentSec Int             @default(0)
  status       AttemptStatus   @default(DRAFT)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  submittedAt  DateTime?

  versions   WritingDraftVersion[]
  assessment WritingAssessment?

  @@index([userId, createdAt])
}

model WritingDraftVersion {
  id        String         @id @default(cuid())
  attemptId String
  attempt   WritingAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  content   String
  wordCount Int
  createdAt DateTime       @default(now())

  @@index([attemptId, createdAt])
}

model WritingAssessment {
  id          String         @id @default(cuid())
  attemptId   String         @unique
  attempt     WritingAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  overallBand Float
  taBand      Float // Task Achievement (T1) / Task Response (T2)
  ccBand      Float
  lrBand      Float
  graBand     Float
  feedback    Json
  model       String
  createdAt   DateTime       @default(now())
}

// ───────────────────────────── Speaking ─────────────────────────────

model SpeakingPrep {
  id        String        @id @default(cuid())
  topicId   String        @unique
  topic     SpeakingTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  content   Json
  model     String
  createdAt DateTime      @default(now())
}

model SpeakingSession {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId   String?
  topic     SpeakingTopic? @relation(fields: [topicId], references: [id], onDelete: SetNull)
  mode      SpeakingMode
  part      Int // 1,2,3 for practice; 0 = full interview
  status    String        @default("IN_PROGRESS") // IN_PROGRESS | COMPLETED
  /// Interview state (examiner turns) for INTERVIEW mode.
  interview Json?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  recordings  SpeakingRecording[]
  assessments SpeakingAssessment[]

  @@index([userId, createdAt])
}

model SpeakingRecording {
  id            String          @id @default(cuid())
  sessionId     String
  session       SpeakingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  attempt       Int // 1 = first attempt, 2 = after preparation; interview uses 1
  questionIndex Int
  questionText  String
  audioPath     String
  mimeType      String
  sizeBytes     Int
  durationSec   Float?
  /// Verbatim transcript from the speech-to-text service. Never edited.
  transcript    String?
  /// Segment/word timestamps + confidences from the STT service.
  segments      Json?
  /// AI annotations pointing at spans of the verbatim transcript (grammar, repetition, ...).
  annotations   Json?
  /// Objective measurements computed from the audio/transcription (speech rate, pauses, ...).
  audioMetrics  Json?
  /// Pronunciation assessment from a dedicated audio service, if configured.
  pronunciation Json?
  sttProvider   String?
  createdAt     DateTime        @default(now())

  @@index([sessionId, attempt, questionIndex])
}

model SpeakingAssessment {
  id                    String          @id @default(cuid())
  sessionId             String
  session               SpeakingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  attempt               Int
  overallBand           Float?
  fcBand                Float
  lrBand                Float
  graBand               Float
  pronBand              Float? // null when no audio pronunciation service is configured
  pronunciationAssessed Boolean         @default(false)
  feedback              Json
  model                 String
  createdAt             DateTime        @default(now())

  @@unique([sessionId, attempt])
}

// ───────────────────────────── Learning memory ─────────────────────────────

model Weakness {
  id                  String         @id @default(cuid())
  userId              String
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  key                 String // normalised category, e.g. "articles"
  name                String
  skills              Skill[]
  severity            Int            @default(2) // 1 low .. 3 high
  explanation         String
  recommendedPractice String
  status              WeaknessStatus @default(ACTIVE)
  firstSeen           DateTime       @default(now())
  lastSeen            DateTime       @default(now())

  occurrences WeaknessOccurrence[]

  @@unique([userId, key])
}

model WeaknessOccurrence {
  id         String   @id @default(cuid())
  weaknessId String
  weakness   Weakness @relation(fields: [weaknessId], references: [id], onDelete: Cascade)
  skill      Skill
  sourceId   String // WritingAttempt.id or SpeakingSession.id
  example    String
  correction String?
  createdAt  DateTime @default(now())

  @@index([weaknessId, createdAt])
}

model VocabItem {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expression String
  kind       VocabKind
  uzbek      String?
  definition String?
  example    String?
  topic      String?
  learned    Boolean   @default(false)
  sourceSkill Skill?
  createdAt  DateTime  @default(now())

  usages VocabUsage[]

  @@unique([userId, expression])
}

model VocabUsage {
  id        String       @id @default(cuid())
  vocabId   String
  vocab     VocabItem    @relation(fields: [vocabId], references: [id], onDelete: Cascade)
  skill     Skill
  sourceId  String
  verdict   UsageVerdict
  context   String
  comment   String?
  createdAt DateTime     @default(now())

  @@index([vocabId, createdAt])
}

model WeeklyReport {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart DateTime
  data      Json
  createdAt DateTime @default(now())

  @@unique([userId, weekStart])
}

model LearningGoal {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  targetDate DateTime?
  done       Boolean   @default(false)
  createdAt  DateTime  @default(now())
}

/// Band 6 / 7 / 8 illustrative answers, cached per question.
model BandComparison {
  id         String   @id @default(cuid())
  skill      Skill
  questionId String
  content    Json
  model      String
  createdAt  DateTime @default(now())

  @@unique([skill, questionId])
}

// ───────────────────────────── Admin / platform ─────────────────────────────

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model AiUsageLog {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  feature      String
  provider     String
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  cachedTokens Int      @default(0)
  audioSeconds Float    @default(0)
  success      Boolean  @default(true)
  error        String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  userId    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
